# Copy to .env (next to docker-compose.yml) to change this component's local settings.
EFFORT_DB_PASSWORD=effort-local
TAWOS_MYSQL_PASSWORD=tawos-local
# true builds the service with torch (~1.5 GB more) and serves every arena configuration: the SBERT ones, M3, the
# stack and, on the machine that holds its weights, DistilBERT.
EFFORT_WITH_TORCH=false

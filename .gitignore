# Only generated and heavy files are ignored: source code, configuration and docs are always committed.
# Data lives in AgilePlatform/Datasets, next to the repositories. Trained models are committed under
# ml-engine/models/ in formats that cannot run code when loaded (no pickles); weight files elsewhere stay ignored.

# Secrets: commit .env.example, never .env
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*

# Data, model weights and experiment outputs
ml-engine/data/
ml-engine/artifacts/
mlruns/
*.parquet
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.ckpt
*.h5
*.joblib
*.pkl
# ...except our own trained models (M3 is a few hundred kB of safetensors)
!ml-engine/models/**/*.safetensors
# Fine-tuned DistilBERT is about 135 MB per task, over GitHub's 100 MB file limit: kept out of git for now
ml-engine/models/**/distilbert/*.safetensors

# Editors and operating systems
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.DS_Store
Thumbs.db

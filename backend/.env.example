# Copy to backend/.env to override the defaults in app/config.py. Never commit .env (the repository is public).
# The hosted database (Neon): paste its direct connection string (host without "-pooler"); postgresql://... works
# as given. Without DATABASE_URL the service uses the local effort-db container (docker compose up -d effort-db).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
CORS_ORIGINS=["http://localhost:3000"]
# Where the trained arena models are (default: ../ml-engine/models/arena-v1 in this repository)
# MODELS_DIR=C:/path/to/ml-engine/models/arena-v1
# PRELOAD_MODELS=true
